---
import { getEntry } from 'astro:content'
import logo72 from '../assets/logo-72.webp'
import logo144 from '../assets/logo-144.webp'
import Footer from '../components/Footer.astro'
import PreRegisterForm from '../components/PreRegisterForm'
import Base from '../layouts/Base.astro'
import '../styles/landing.css'

const landing = await getEntry('copy', 'landing.es')
if (!landing) throw new Error('Content entry copy/landing.es is missing')

const copy = landing.data
const { hero, benefits, form, simplified_aviso: aviso } = copy
const [before, after] = hero.headline.split(hero.highlight)
---

<Base title={copy.meta.title} description={copy.meta.description}>
  <main class="page">
    <!-- ════ left panel ════ -->
    <section class="left" aria-labelledby="hero-title">
      <div class="logo-wrap">
        <img
          class="logo-img"
          src={logo72.src}
          srcset={`${logo72.src} 1x, ${logo144.src} 2x`}
          width="72"
          height="72"
          alt="Logotipo de Matchport"
        />
        <span class="logo-name">MATCHPORT</span>
      </div>

      <div class="hero-text">
        <p class="eyebrow">{hero.eyebrow}</p>

        <h1 id="hero-title">{before}<span class="hl">{hero.highlight}</span>{after}</h1>

        <p class="sub">{hero.subheadline}</p>

        <!-- Pre-launch note — replaces the live page's fabricated counter
             (LP-1 §7.2: no number until a real threshold exists). -->
        <div class="prelaunch-card">
          <p>
            {hero.prelaunch}
            <span>Grupo fundador · Puerto de Manzanillo</span>
          </p>
        </div>

        <!-- benefits (LP-1 §7.3 — reworded honestly) -->
        <ul class="benefits">
          <li class="benefit">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#3A6EF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </span>
            <p class="benefit-text">
              <strong>{benefits[0]?.title}</strong>
              {benefits[0]?.description}
            </p>
          </li>
          <li class="benefit">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#3A6EF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 7V5a2 2 0 0 0-4 0v2"></path><line x1="12" y1="12" x2="12" y2="16"></line></svg>
            </span>
            <p class="benefit-text">
              <strong>{benefits[1]?.title}</strong>
              {benefits[1]?.description}
            </p>
          </li>
          <li class="benefit">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="#3A6EF0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </span>
            <p class="benefit-text">
              <strong>{benefits[2]?.title}</strong>
              {benefits[2]?.description}
            </p>
          </li>
        </ul>
      </div>
    </section>

    <!-- ════ right panel ════ -->
    <section class="right" aria-labelledby="form-title">
      <div class="form-header">
        <h2 id="form-title">{form.title}</h2>
        <p>{form.subtitle}</p>
      </div>

      <!-- pre-registration form island (client:visible — the only JS on the page) -->
      <PreRegisterForm client:visible copy={copy} />

      {/* simplified aviso (LP-1 §3) — next to the submit button */}
      <aside class="simplified-aviso" aria-label={aviso.title}>
        <span class="sa-title">{aviso.title}</span>
        <p>
          {aviso.body}{' '}
          <a href="/aviso-de-privacidad">{aviso.link_text}</a> {aviso.link_note}
        </p>
      </aside>
    </section>
  </main>
  <Footer copy={copy.footer} />
</Base>
