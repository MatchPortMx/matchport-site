{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-prime",
  "small_model": "openrouter/z-ai/glm-5.3-prime",
  "default_agent": "site-builder",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["openrouter"],
  "instructions": ["AGENTS.md"],
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny", "*.env.*": "deny", ".env": "deny", ".env.*": "deny",
      ".dev.vars": "deny", "*/.dev.vars": "deny",
      "*.pem": "deny", "*.key": "deny", "auth.json": "deny", "*/auth.json": "deny",
      "credentials*": "deny", "*/credentials*": "deny",
      ".git/*": "deny", "*/.git/*": "deny"
    },
    "glob": "allow",
    "list": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": { "*": "deny" },
    "doom_loop": "ask"
  }
}
